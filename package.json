{
  "name": "yomi-core-api",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @yomi/server dev",
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run scripts/e2e-smoke.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/node-server": "1.19.17"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "^1.9.4",
    "msw": "^2.7.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
